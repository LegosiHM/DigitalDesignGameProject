script = ExtResource("19_my3qs")
dialog_lines = Array[String](["\"...\"", "\"Congrats!\"", "\"You've survived all the plagues!\"", "...Okay, done with the chitchat.", "I don't know if you really understand me or not,", "but thanks for helping me.", "...Ignore the torn glitchy book in my back.", "That's the broken reality created by this \"Time Machine\"", "Do you know how your owner named it?", "CODE42...", "MEDJED...", "THE BOOK OF HISTORY...", "That's me! From the future!", "Actually it's me now, but my creation will start from now on!", "Don't forget to tell your owner to finish this project!", "...Okay, So...", "...I, Medjed, will honor you!", "You can go now.", "Just step out of this book.", "Jump out from some corner of the page.", "See you! Until we meet again...", "...You still trust me, right?", "...Whatever"])
dialog_position_Array = Array[Vector2]([Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200), Vector2(1200, 200)])
